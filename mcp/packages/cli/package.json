{
  "name": "@penpot/cli",
  "version": "1.0.0",
  "description": "CLI for orchestrating Penpot MCP tools in the correct order",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "penpot-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" --packages=external",
    "types:check": "tsc --noEmit",
    "clean": "rm -rf dist/"
  },
  "keywords": ["penpot", "mcp", "cli"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "commander": "^13.1.0",
    "chalk": "^5.4.1",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "ts-node": {
    "esm": true
  }
}
